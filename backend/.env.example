# Sao chép file này thành .env rồi sửa mật khẩu MySQL của bạn:
#   copy .env.example .env

FLASK_ENV=development

# Đổi MAT_KHAU_MYSQL thành mật khẩu root MySQL trên máy bạn
DATABASE_URL=mysql+pymysql://root:MAT_KHAU_MYSQL@localhost:3306/grapehrm

JWT_SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=GrapeHRM <noreply@grapehrm.com>
